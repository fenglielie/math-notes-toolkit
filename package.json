{
  "name": "math-notes-cli",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "description": "Mathematical Markdown rendering, a static notes website framework, and a companion VS Code extension.",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "math-notes-cli": "./bin/math-notes-cli.mjs"
  },
  "exports": {
    ".": "./scripts/build.mjs",
    "./core": "./src/core/index.mjs",
    "./render": "./src/core/node.mjs",
    "./preset": "./src/core/preset.mjs",
    "./styles/highlights.css": "./styles/highlights.css",
    "./SYNTAX.md": "./SYNTAX.md",
    "./examples/*": "./examples/*"
  },
  "files": [
    "bin",
    "scripts",
    "!scripts/check-*.mjs",
    "src/core",
    "styles",
    "assets",
    "starter",
    "examples",
    "README.md",
    "DEVELOPMENT.md",
    "SYNTAX.md",
    "extension/README.md",
    "LICENSE"
  ],
  "scripts": {
    "build:latex": "node bin/math-notes-cli.mjs build:latex --config site.demo.config.mjs",
    "dev:demo": "node --watch bin/math-notes-cli.mjs dev --config site.demo.config.mjs",
    "dev": "npm run dev:demo",
    "test": "node --test \"test/**/*.test.mjs\" \"extension/test/*.test.mjs\"",
    "check": "npm run build:demo && npm run build:extension && npm test && npm run test:extension",
    "test:browser": "node scripts/check-browser.mjs",
    "package": "npm run check && npm pack",
    "test:package": "node test/installed-package.mjs",
    "build:demo": "node bin/math-notes-cli.mjs build --config site.demo.config.mjs",
    "build:extension": "node tools/build-extension.mjs",
    "test:extension": "node extension/test/browser.mjs",
    "package:extension": "node tools/package-extension.mjs"
  },
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@mathjax/src": "4.1.3",
    "@mathjax/mathjax-newcm-font": "4.1.3",
    "markdown-it": "14.3.2",
    "markdown-it-footnote": "4.0.0",
    "highlight.js": "11.12.0",
    "pdfjs-dist": "^6.3.289",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2"
  }
}
